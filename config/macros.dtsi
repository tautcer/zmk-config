MACRO(mc_qmark,               &kp QMARK )
// End?
MACRO(mc_end_qmark,           &kp END &mc_qmark )
// tap: ? | hold: End?
TAPHOLD_TP(th_qmark,          &mc_qmark, &mc_end_qmark)

// !
MACRO(mc_excl,               &kp EXCL)
