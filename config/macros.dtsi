// ->
ZMK_MACRO(r_sml_arr,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp MINUS  &kp GT>;
)

// =>
ZMK_MACRO(r_big_arr,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp EQUAL  &kp GT>;
)

// <-
ZMK_MACRO(l_sml_arr,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp LT &kp MINUS>;
)

// <=
ZMK_MACRO(l_big_arr,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp LT &kp EQUAL>;
)

// :%s/
ZMK_MACRO(mc_colpercsslash,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp COLON &kp PERCENT &kp S &kp SLASH>;
)

// ~/
ZMK_MACRO(mc_tisl,
    wait-ms = <5>;
    tap-ms = <5>;
    bindings = <&kp TILDE &kp SLASH &kp SPACE>;
)

// ./
ZMK_MACRO(mc_ds,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOT &kp SLASH>;
)

// ../
ZMK_MACRO(mc_dds,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOT &kp DOT &kp SLASH>;
)

// - [ ] 
ZMK_MACRO(mc_otask,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp MINUS &kp SPACE &kp LBKT &kp SPACE &kp RBKT &kp SPACE>;
)

// Tap 	Long press
// _ < > / \ # 	Double, e.g __
// " ' = ` 0 . 	Triple, e.g """
// | & = 	Double with spaces, e.g  || 
// ! 	 !=  (with spaces)
// ? 	{:?}
// # 	{:#?}
// % 	%{}
// ( [ { 	Close and move cursor between

// _ 
MACRO(mc_und,                 &kp UNDER &kp SPACE)
// End_ 
MACRO(mc_end_und,             &kp END &mc_und)
// tap: _  | hold: End_ 
TAPHOLD_TP(th_und,            &mc_und, &mc_end_und)

// ' 
MACRO(mc_sqo,                 &kp SQT &kp SPACE)
// End' 
MACRO(mc_end_sqo,             &kp END &mc_sqo)
// tap: '  | hold: End' 
TAPHOLD_TP(th_sqo,            &mc_sqo, &mc_end_sqo)

// " 
MACRO(mc_dqo,                 &kp DQT &kp SPACE)
// End" 
MACRO(mc_end_dqo,             &kp END &mc_dqo)
// tap: "  | hold: End" 
TAPHOLD_TP(th_dqo,            &mc_dqo, &mc_end_dqo)

// ` 
MACRO(mc_bti,                 &kp GRAVE &kp SPACE)
// End` 
MACRO(mc_end_bti,             &kp END &mc_bti)
// tap: `  | hold: End` 
TAPHOLD_TP(th_bti,            &mc_bti, &mc_end_bti)

// &&
MACRO(mc_and,                 &kp AMPS &kp AMPS)
// → &&
MACRO(mc_right_and,           &kp RIGHT &kp SPACE &kp AMPS &kp AMPS)
// tap: && | hold: → &&
TAPHOLD_TP(th_and,            &mc_and, &mc_right_and)

// ||
MACRO(mc_or,                  &kp PIPE &kp PIPE)
// → ||
MACRO(mc_right_or,            &kp RIGHT &kp SPACE &kp PIPE &kp PIPE)
// tap: || | hold: → ||
TAPHOLD_TP(th_or,             &mc_or, &mc_right_or)

// {
MACRO(mc_lbrc,                &kp LBRC)
// End {
MACRO(mc_end_lbrc,            &kp END &kp SPACE &kp LBRC)
// tap: { | hold: End {
TAPHOLD_TP(th_lbrc,           &mc_lbrc, &mc_end_lbrc)

// }
MACRO(mc_rbrc,                &kp RBRC)
// End }
MACRO(mc_end_rbrc,            &kp END &kp SPACE &kp RBRC)
// tap: } | hold: End }
TAPHOLD_TP(th_rbrc,           &mc_rbrc, &mc_end_rbrc)

// (
MACRO(mc_lpar,                &kp LPAR)
// End(
MACRO(mc_end_lpar,            &kp END &kp LPAR)
// tap: ( | hold: End(
TAPHOLD_TP(th_lpar,           &mc_lpar, &mc_end_lpar)

// )
MACRO(mc_rpar,                &kp RPAR)
// End)
MACRO(mc_end_rpar,            &kp END &kp RPAR)
// tap: ) | hold: End)
TAPHOLD_TP(th_rpar,           &mc_rpar, &mc_end_rpar)

// ()
MACRO(mc_pars,                &kp LPAR &kp RPAR)
// End()
MACRO(mc_end_pars,            &kp END &kp LPAR &kp RPAR)
// tap: () | hold: End()
TAPHOLD_TP(th_pars,           &mc_pars, &mc_end_pars)

// [
MACRO(mc_lbkt,                &kp LBKT)
// →[
MACRO(mc_end_lbkt,            &kp RIGHT &kp LBKT)
// tap: [ | hold: →[
TAPHOLD_TP(th_lbkt,           &mc_lbkt, &mc_end_lbkt)

// ]
MACRO(mc_rbkt,                &kp RBKT)
// →]
MACRO(mc_end_rbkt,            &kp RIGHT &kp RBKT)
// tap: ] | hold: →]
TAPHOLD_TP(th_rbkt,           &mc_rbkt, &mc_end_rbkt)

// End();
MACRO(mc_pars_semi,           &kp END &kp LPAR &kp RPAR &kp SEMI)

// """ 
MACRO(mc_tdqo,                &mc_dqo &mc_dqo &mc_dqo)
// """↵
MACRO(mc_tdqo_ent,            &mc_tdqo &kp ENTER)
// tap: """  | hold: """ ↵
TAPHOLD_TP(th_tdqo,           &mc_tdqo, &mc_tdqo_ent)

// ``` 
MACRO(mc_tbti,                &mc_bti &mc_bti &mc_bti)
// ```↵
MACRO(mc_tbti_ent,            &mc_tbti &kp ENTER)
// tap: ```  | hold: ``` ↵
TAPHOLD_TP(th_tbti,           &mc_tbti, &mc_tbti_ent)

// End {↵
MACRO(mc_braces_new,          &kp END &kp SPACE &kp LBRC &kp ENTER)

// ->
MACRO(mc_sarrow,              &kp MINUS &kp GT)
// → ->
MACRO(mc_end_sarrow,          &kp RIGHT &kp SPACE &kp MINUS &kp GT)
// tap: -> | hold: → ->
TAPHOLD_TP(th_sarrow,         &mc_sarrow, &mc_end_sarrow)

// =>
MACRO(mc_darrow,              &kp EQUAL &kp GT)
// → =>
MACRO(mc_end_darrow,          &kp RIGHT &kp SPACE &kp EQUAL &kp GT)
// tap: => | hold: → =>
TAPHOLD_TP(th_darrow,         &mc_darrow, &mc_end_darrow)

// ${
MACRO(mc_dcurly,              &kp DOLLAR &kp LBRC)
// #{
MACRO(mc_hcurly,              &kp HASH &kp LBRC)
// %{
MACRO(mc_pcurly,              &kp PERCENT &kp LBRC)

// %
MACRO(mc_perc,                &kp PERCENT)
// End %
MACRO(mc_end_perc,            &kp END &kp SPACE &kp PERCENT)
// tap: % | hold: End %
TAPHOLD_TP(th_perc,           &mc_perc, &mc_end_perc)

// <
MACRO(mc_lt,                  &kp LT)
// → <
MACRO(mc_end_lt,              &kp RIGHT &kp SPACE &mc_lt )
// tap: < | hold: → <
TAPHOLD_TP(th_lt,             &mc_lt, &mc_end_lt)

