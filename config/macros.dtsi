MACRO(mc_qmark,               &kp QMARK )
// End?
MACRO(mc_end_qmark,           &kp END &mc_qmark )
// tap: ? | hold: End?
TAPHOLD_TP(th_qmark,          &mc_qmark, &mc_end_qmark)

// !
MACRO(mc_excl,               &kp EXCL)
// End!
MACRO(mc_end_excl,           &kp END &mc_excl)
// tap: ! | hold: End!
TAPHOLD_TP(th_excl,          &mc_excl, &mc_end_excl)

// `
MACRO(mc_grave,               &kp GRAVE)
// End`
MACRO(mc_end_grave,           &kp END &kp SPACE &mc_grave)
// tap: ` | hold: End `
TAPHOLD_TP(th_grave,          &mc_grave, &mc_end_grave)

// |
MACRO(mc_pipe,                &kp PIPE)
// End |
MACRO(mc_end_pipe,            &kp END &kp SPACE &mc_pipe)
// tap: | | hold: End |
TAPHOLD_TP(th_pipe,           &mc_pipe, &mc_end_pipe)

