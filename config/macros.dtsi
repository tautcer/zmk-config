TAPHOLD_TP(th_gt,             &mc_gt, &mc_end_gt)

// +
MACRO(mc_plus,                &kp PLUS)
// → +
MACRO(mc_end_plus,            &kp RIGHT &kp SPACE &mc_plus )
// tap: + | hold: → +
TAPHOLD_TP(th_plus,           &mc_plus, &mc_end_plus)

