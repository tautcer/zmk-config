TAPHOLD_TP(th_semicolon,      &mc_semicolon, &mc_end_semicolon)

// === macOS variants (replace &kp END with &kp LG(RIGHT)) ===
// Only needed for keys whose hold behavior still types to end-of-line.

// macOS: End ^
MACRO(mc_end_caret_mac,       &kp LG(RIGHT) &kp SPACE &mc_caret)
// tap: ^  | hold: End ^ (mac)
TAPHOLD_TP(th_caret_mac,      &mc_caret, &mc_end_caret_mac)

// macOS: End $
MACRO(mc_end_dllr_mac,        &kp LG(RIGHT) &kp SPACE &mc_dllr)
// tap: $  | hold: End $ (mac)
TAPHOLD_TP(th_dllr_mac,       &mc_dllr, &mc_end_dllr_mac)

// macOS: End }
MACRO(mc_end_rbrc_mac,        &kp LG(RIGHT) &kp SPACE &kp RBRC)
// tap: }  | hold: End } (mac)
TAPHOLD_TP(th_rbrc_mac,       &mc_rbrc, &mc_end_rbrc_mac)

// macOS: End)
MACRO(mc_end_rpar_mac,        &kp LG(RIGHT) &kp RPAR)
// tap: )  | hold: End) (mac)
TAPHOLD_TP(th_rpar_mac,       &mc_rpar, &mc_end_rpar_mac)

// macOS: End ;
MACRO(mc_end_semicolon_mac,   &kp LG(RIGHT) &kp SPACE &mc_semicolon)
// tap: ;  | hold: End ; (mac)
TAPHOLD_TP(th_semicolon_mac,  &mc_semicolon, &mc_end_semicolon_mac)

// macOS: End ~
MACRO(mc_end_tilde_mac,       &kp LG(RIGHT) &kp SPACE &mc_tilde)
// tap: ~  | hold: End ~ (mac)
TAPHOLD_TP(th_tilde_mac,      &mc_tilde, &mc_end_tilde_mac)

// macOS: End %
MACRO(mc_end_perc_mac,        &kp LG(RIGHT) &kp SPACE &kp PERCENT)
// tap: %  | hold: End % (mac)
TAPHOLD_TP(th_perc_mac,       &mc_perc, &mc_end_perc_mac)

// macOS: End @
MACRO(mc_end_at_mac,          &kp LG(RIGHT) &kp SPACE &mc_at)
// tap: @  | hold: End @ (mac)
TAPHOLD_TP(th_at_mac,         &mc_at, &mc_end_at_mac)

// macOS: End :
MACRO(mc_end_colon_mac,       &kp LG(RIGHT) &kp SPACE &mc_colon)
// tap: :  | hold: End : (mac)
TAPHOLD_TP(th_colon_mac,      &mc_colon, &mc_end_colon_mac)

// macOS: End ,
MACRO(mc_end_comma_mac,       &kp LG(RIGHT) &kp SPACE &mc_comma)
// tap: ,  | hold: End , (mac)
TAPHOLD_TP(th_comma_mac,      &mc_comma, &mc_end_comma_mac)

// macOS: End?
MACRO(mc_end_qmark_mac,       &kp LG(RIGHT) &mc_qmark)
// tap: ?  | hold: End? (mac)
TAPHOLD_TP(th_qmark_mac,      &mc_qmark, &mc_end_qmark_mac)
